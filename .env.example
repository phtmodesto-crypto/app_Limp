# ─── Banco de Dados ───────────────────────────────────────────────────────────
# Desenvolvimento (SQLite)
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL — descomente e preencha)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/limpservice_curriculos?schema=public"

# ─── Autenticação (NextAuth.js) ───────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="coloque-aqui-um-secret-forte-de-pelo-menos-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# ─── E-mail (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# E-mail do responsável de RH que receberá as candidaturas
RH_EMAIL="rh@grupollimpservice.com.br"

# E-mail remetente verificado no Resend (deve ser de domínio verificado)
EMAIL_FROM="curriculos@grupollimpservice.com.br"

# ─── Storage de Currículos ────────────────────────────────────────────────────
# Desenvolvimento: usa pasta local /uploads (criada automaticamente)
# Produção: use Vercel Blob ou S3

# Vercel Blob (recomendado para Vercel)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# AWS S3 (alternativa)
# AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
# AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
# AWS_REGION="sa-east-1"
# AWS_S3_BUCKET="limpservice-curriculos"

# ─── Admin padrão (usado no seed) ────────────────────────────────────────────
ADMIN_EMAIL="admin@grupollimpservice.com.br"
ADMIN_SENHA="Limpservice@2025"
ADMIN_NOME="RH Limpservice"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
