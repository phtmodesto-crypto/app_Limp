# ─── Banco de Dados ───────────────────────────────────────────────────────────
# Desenvolvimento local (SQLite)
DATABASE_URL="file:./dev.db"

# Produção com Supabase (PostgreSQL)
# Use o Transaction Pooler (porta 6543) para Next.js serverless
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# URL direta para migrações Prisma (Session Pooler — porta 5432)
# Necessária ao usar Supabase com pooler no DATABASE_URL
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Obtenha em: https://supabase.com/dashboard/project/[PROJECT-REF]/settings/api

# URL do projeto Supabase (pública — usado no cliente)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Chave anônima (pública — segura para expor no frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Chave service_role (SECRETA — nunca exponha no cliente!)
# Usada exclusivamente em Route Handlers / Server Actions para:
# - Upload no Supabase Storage (lib/supabase/storage.ts)
# - Acesso admin ao banco com bypass de RLS
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Nome do bucket para currículos (criado via migration ou Dashboard)
SUPABASE_STORAGE_BUCKET="curriculos"

# ─── Autenticação (NextAuth.js) ───────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="coloque-aqui-um-secret-forte-de-pelo-menos-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# ─── E-mail (Resend) ──────────────────────────────────────────────────────────
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# E-mail do responsável de RH que receberá as candidaturas
RH_EMAIL="rh@grupollimpservice.com.br"

# E-mail remetente verificado no Resend (deve ser de domínio verificado)
EMAIL_FROM="curriculos@grupollimpservice.com.br"

# ─── Storage de Currículos ────────────────────────────────────────────────────
# Desenvolvimento: salva em /public/uploads (padrão, sem config adicional)
# Produção com Supabase: use lib/supabase/storage.ts (configure SUPABASE_* acima)
# Produção com Vercel Blob (alternativa):
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# ─── Admin padrão (usado no seed) ────────────────────────────────────────────
ADMIN_EMAIL="admin@grupollimpservice.com.br"
ADMIN_SENHA="Limpservice@2025"
ADMIN_NOME="RH Limpservice"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
