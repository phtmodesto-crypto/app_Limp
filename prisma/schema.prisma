generator client {
  provider = "prisma-client-js"
}

// ─── Banco de dados ───────────────────────────────────────────────────────────
// Desenvolvimento local → SQLite  (DATABASE_URL="file:./dev.db")
// Produção / Supabase  → PostgreSQL (veja .env.example)
//
// Para alternar:
//   1. Atualize o DATABASE_URL no .env
//   2. Troque "sqlite" por "postgresql" abaixo
//   3. Adicione directUrl = env("DIRECT_URL") para Supabase com pooler
//   4. Execute: npx prisma db push  (ou prisma migrate deploy em produção)

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
  // Descomente as linhas abaixo ao usar Supabase (PostgreSQL):
  // provider  = "postgresql"
  // url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model Candidatura {
  id        String   @id @default(cuid())
  protocolo String   @unique

  // Dados pessoais
  nomeCompleto String
  dataNasc     String
  telefone     String
  whatsapp     String?
  email        String
  cidade       String
  estado       String

  // Vaga de interesse
  cargo             String
  turno             String  // JSON: string[]
  pretensaoSalarial Float?

  // Experiência profissional (JSON serializado)
  experiencias String // JSON: Experiencia[]

  // Formação e cursos (JSON serializado)
  escolaridade String
  cursos       String // JSON: Curso[]

  // Autoavaliação (JSON serializado) e pontuações
  autoavaliacao  String // JSON: Record<string, number>
  pontuacaoAuto  Float  // pontuação da autoavaliação (0-60)
  pontuacaoCompl Float  // pontuação de completude (0-40)
  pontuacaoTotal Float  // total (0-100)
  classificacao  String // "Perfil em Destaque" | "Perfil Adequado" | "Em Análise"

  // Currículo uploadado
  curriculoUrl     String?
  curriculoNome    String?
  curriculoTipo    String?
  curriculoTamanho Int?

  // Caminho no Supabase Storage (quando usar lib/supabase/storage.ts)
  curriculoStoragePath String?

  // LGPD
  lgpdAceite   Boolean
  lgpdDataHora DateTime

  // Status da candidatura
  status          String @default("NOVO") // NOVO | EM_ANALISE | ENTREVISTA | APROVADO | REPROVADO
  statusHistorico String @default("[]")   // JSON: StatusEntry[]

  // Metadados técnicos
  ipOrigem  String?
  userAgent String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // LGPD — anonimização
  anonimizado    Boolean   @default(false)
  anonimizadoEm  DateTime?
  anonimizadoPor String?
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  senha     String   // bcrypt hash
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
